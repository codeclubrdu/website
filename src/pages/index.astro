---
import Main from '../layouts/main.astro';
import { Image } from 'astro:assets';
import photo from '../assets/groupPhoto.webp';
import { nextEvent, formatDay } from '../data/events';
---

<Main>
	<div class="">
		<h1 class="mb-0 pl-5 text-left text-2xl">Welcome to <b>Code Club</b> RDU's homepage</h1>
		<div class="flex flex-col p-5">
			<p>
				We're a group of North Carolina based developers who want to hone their craft through
				hands-on practice and collaborative learning. Whether you're self-taught, boot camp trained
				or CS degreed, you have a place with us.
			</p>
			<p>Join us every first Thursday of the month to share ideas, connect, and practice</p>
			<div class="place-self-left max-w-137.5 pt-5">
				<Image src={photo} alt="Photo of group members" width={500} quality="mid" />
			</div>
			{
				nextEvent ? (
					<div>
						<p class="p-d text-left">Next Event:</p>
						<div class="place-self-left flex flex-col border-solid border-black p-5">
							<ul class="list-none p-0">
								<li class="mb-3">{nextEvent.event}:</li>
								<li>{formatDay(nextEvent.date)}</li>
								<li class="mb-3">{nextEvent.time}</li>
								<li>{nextEvent.place}</li>
								<li>{nextEvent.address}</li>
								<li class="mb-3">{nextEvent.city}</li>
							</ul>
							<div class="center flex flex-row justify-between">
								<a
									class="inline-flex h-7 w-35 items-center justify-center bg-black p-2 text-white"
									href="/events"
								>
									More Info
								</a>
								<a
									class="inline-flex h-7 w-35 items-center justify-center bg-black p-2 text-white"
									href={nextEvent.meetupLink}
								>
									RSVP on Meetup
								</a>
							</div>
						</div>
					</div>
				) : (
					<p>Next event TBA — keep an eye on our Meetup!</p>
				)
			}
		</div>
	</div>
</Main>
