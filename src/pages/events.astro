---
import Main from '../layouts/main.astro';
import { upcomingEvents, pastEvents, formatDay } from '../data/events';
---

<Main title="Events | Code Club RDU">
	<h1 class="mb-0 pl-5 text-left text-2xl">Events</h1>
	<div class="flex flex-col p-5">
		<section id="events" class="p-5">
			<h2>Upcoming</h2>
			{upcomingEvents.length === 0 && <p>No upcoming events yet — check back soon!</p>}
			{
				upcomingEvents.map(({ event, date, time, place, address, city, meetupLink, details }) => (
					<article data-event-card data-date={date} class="mb-5">
						<h3>
							{event} · {formatDay(date)} · {time}
						</h3>
						<div>{place}</div>
						<div>{address}</div>
						<div class="mb-3">{city}</div>
						{details.notes.map((n) => (
							<p>{n}</p>
						))}
						{details.agenda.length > 0 && (
							<>
								<h4>Agenda</h4>
								<ul>
									{details.agenda.map(({ time, item }) => (
										<li>
											<b>{time}</b> — {item}
										</li>
									))}
								</ul>
							</>
						)}
						{details.callToAction && <p>{details.callToAction}</p>}
						<a
							data-rsvp
							class="inline-flex h-7 w-35 items-center justify-center bg-black p-2 text-white"
							href={meetupLink}
						>
							RSVP on Meetup
						</a>
					</article>
				))
			}
		</section>
		<section id="recaps" class="p-5">
			<h2>Past Events & Recaps</h2>
			<div data-past-list>
				{
					pastEvents.map(({ event, date, place, details, recap }) => (
						<article class="mb-5">
							<h3>{event}</h3>
							<div class="mb-3 text-neutral-500">
								Held on {formatDay(date)} · {place}
							</div>
							{recap && (
								<div>
									{recap.map((paragraph) => (
										<p>{paragraph}</p>
									))}
								</div>
							)}
							{(details.agenda.length > 0 || details.notes.length > 0) && (
								<details class="mt-3">
									<summary class="cursor-pointer text-neutral-500">Original event details</summary>
									{details.notes.map((n) => (
										<p class="text-neutral-500">{n}</p>
									))}
									{details.agenda.length > 0 && (
										<ul class="text-neutral-500">
											{details.agenda.map(({ time, item }) => (
												<li>
													<b>{time}</b> — {item}
												</li>
											))}
										</ul>
									)}
								</details>
							)}
						</article>
					))
				}
			</div>
		</section>
	</div>
</Main>

<script>
	// Static build only reclassifies on deploy; fix any card that went stale since.
	const today = new Date().toLocaleDateString('sv');
	const pastList = document.querySelector('[data-past-list]');
	document.querySelectorAll<HTMLElement>('#events [data-event-card]').forEach((card) => {
		const date = card.dataset.date;
		if (!date || date >= today) return;
		const badge = card.querySelector('[data-badge]');
		if (badge) {
			badge.textContent = 'Past event';
			badge.className =
				'inline-block rounded-full bg-neutral-200 px-2 py-0.5 text-xs font-semibold text-neutral-600 uppercase';
		}
		card.querySelector('[data-rsvp]')?.remove();
		pastList?.prepend(card);
	});
</script>
