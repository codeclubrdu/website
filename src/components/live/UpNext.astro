---
// AI-coded (Claude) under the owner's /live exemption — see docs/live-dashboard.md
// Markup only. live.astro sets [data-upnext-label] ('NEXT' | 'THEN'), [data-upnext-item], [data-upnext-at].
import Window from './Window.astro';
---

<Window title="UP NEXT" name="upnext">
	<div class="upnext">
		<div class="upnext-label">
			<span data-upnext-label>NEXT</span> · <span class="upnext-at" data-upnext-at></span>
		</div>
		<div class="upnext-item" data-upnext-item></div>
	</div>
</Window>
