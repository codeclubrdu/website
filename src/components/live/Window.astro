---
// AI-coded (Claude) under the owner's /live exemption — see docs/live-dashboard.md
// Titlebar + bevel shell. y2k chrome (fake buttons, bevels) lands in S3 via live.css.
type Props = { title: string; name: string; class?: string };
const { title, name, class: cls } = Astro.props;
---

<section class:list={['win', cls]} data-window={name} style={`grid-area: ${name}`}>
	<header class="win-title">
		<span class="win-title-text">{title}</span>
		<span class="win-title-buttons" aria-hidden="true"><i></i><i></i><i></i></span>
	</header>
	<div class="win-body"><slot /></div>
</section>
