---
import { Image } from 'astro:assets';
import logo from '../assets/codeClubLogo.webp';
import { DISCORD_INVITE } from '../data/links';
---

<header>
	<div class="flex flex-row place-content-between">
		<div class="flex=col m-5 pt-5">
			<nav>
				<ul class="list-none p-0">
					<li><a href="/">home</a></li>
					<li><a href="/events#events">events</a></li>
					<li><a href="/events#recaps">recaps</a></li>
					<li><a href="/projects">projects</a></li>
					<li><a href="#team">teams</a></li>

					<li class="mt-3"><a href={DISCORD_INVITE}>discord</a></li>
					<li><a href="https://www.meetup.com/code-club-rdu/">meetup</a></li>
					<li><a href="https://github.com/codeclubrdu">github</a></li>
				</ul>
			</nav>
		</div>
		<div class="mt-0 mr-5">
			<Image src={logo} height="225" alt="Code Club logo" />
		</div>
	</div>
</header>
